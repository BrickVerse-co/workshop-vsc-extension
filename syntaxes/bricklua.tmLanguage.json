{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BrickLua",
  "scopeName": "source.bricklua",
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#engineGlobals"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#properties"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.bricklua",
          "begin": "--\\[\\[",
          "end": "\\]\\]"
        },
        {
          "name": "comment.line.double-dash.bricklua",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bricklua",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.bricklua",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.bricklua",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.bricklua",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.long-bracket.bricklua",
          "begin": "\\[\\[",
          "end": "\\]\\]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.bricklua",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.bricklua",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.bricklua",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bricklua",
          "match": "\\b(and|break|continue|do|else|elseif|end|for|function|goto|if|in|not|or|repeat|return|then|until|while)\\b"
        },
        {
          "name": "storage.modifier.bricklua",
          "match": "\\b(local)\\b"
        },
        {
          "name": "constant.language.bricklua",
          "match": "\\b(false|nil|self|true)\\b"
        },
        {
          "name": "keyword.declaration.bricklua",
          "match": "\\b(type)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.bricklua",
          "match": "(\\+|\\-|\\*|\\/|%|#|\\^|==|~=|<=|>=|<|>|=|\\.\\.|\\.\\.\\.|:|::|->|=>|\\?|!)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.bricklua",
          "match": "\\b(boolean|function|nil|number|string|table|thread|userdata)\\b"
        },
        {
          "name": "support.type.engine.bricklua",
          "match": "\\b(Node|Promise|Script|Vector3|game|game\\.Players|script)\\b"
        },
        {
          "name": "entity.name.type.bricklua",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.type.annotation.bricklua",
          "match": "(:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:<[^>]+>)?)",
          "captures": {
            "1": {
              "name": "keyword.operator.type.annotation.bricklua"
            },
            "2": {
              "name": "support.type.annotation.bricklua"
            }
          }
        }
      ]
    },
    "engineGlobals": {
      "patterns": [
        {
          "name": "support.class.engine-global.bricklua",
          "match": "\\b(Players|game|game\\.Players|script)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.bricklua",
          "match": "(?<=\\bfunction\\s+)[A-Za-z_][A-Za-z0-9_]*(?=\\s*[\\(:])"
        },
        {
          "name": "entity.name.function.method.bricklua",
          "match": "(?<=[:\\.])[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.bricklua",
          "match": "\\b(assert|error|getmetatable|ipairs|next|pairs|pcall|print|rawequal|rawget|rawlen|rawset|require|select|setmetatable|tonumber|tostring|type|typeof|validateType|warn|xpcall)\\b(?=\\s*\\()"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.bricklua",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  },
  "$comment": "AUTO-GENERATED FILE. DO NOT EDIT. Run npm run generate:language."
}
